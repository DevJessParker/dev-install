{
  "_versionExpressionExamples": {
    "_comment": "Version expressions support the following formats:",
    "_example1": "latest - any version is acceptable",
    "_example2": "1.2.3 - exact version required",
    "_example3": ">=1.2.3 - version 1.2.3 or higher",
    "_example4": ">1.2.3 - version higher than 1.2.3",
    "_example5": "<=1.2.3 - version 1.2.3 or lower",
    "_example6": "<1.2.3 - version lower than 1.2.3",
    "_example7": "^1.2.3 - compatible with 1.x.x (>=1.2.3 <2.0.0)",
    "_example8": "~1.2.3 - compatible with 1.2.x (>=1.2.3 <1.3.0)"
  },
  "developmentTools": {
    "chocolatey": {
      "version": "latest",
      "allowGlobalConfiguration": false,
      "source": "script",
      "description": "Package manager for Windows",
      "upgradeIfOutdated": true,
      "useEnhancedExitCodes": true,
      "retryCount": 3,
      "retryDelaySeconds": 5
    },
    "powershellget": {
      "version": "latest",
      "packageName": "PowerShellGet",
      "source": "bootstrap",
      "description": "PowerShell module for discovering and installing modules from PSGallery"
    },
    "nvm": {
      "version": "~1.1.5",
      "packageName": "nvm",
      "source": "chocolatey",
      "description": "Node Version Manager for Windows"
    },
    "node": {
      "version": "~18.19.1",
      "source": "nvm",
      "setAsDefault": true,
      "description": "Node.js JavaScript runtime",
      "dependsOn": ["nvm"]
    },
    "yarn": {
      "version": "~1.22.22",
      "packageName": "yarn",
      "source": "chocolatey",
      "description": "JavaScript package manager"
    },
    "dotnetcore-sdk": {
      "version": "~3.1.201",
      "packageName": "dotnetcore-sdk",
      "source": "chocolatey",
      "description": ".NET Core SDK"
    },
    "awscli": {
      "version": "~2.0.6",
      "packageName": "awscli",
      "source": "chocolatey",
      "description": "AWS Command Line Interface"
    },
    "7zip": {
      "version": "~22.1.0",
      "packageName": "7zip.install",
      "source": "chocolatey",
      "description": "File archiver with high compression ratio"
    },
    "netfx-devpack": {
      "version": "~4.8.0",
      "packageName": "netfx-4.8-devpack",
      "source": "chocolatey",
      "description": ".NET Framework Developer Pack"
    },
    "curl": {
      "version": "latest",
      "packageName": "curl",
      "source": "chocolatey",
      "description": "Command line tool for transferring data"
    },
    "k6": {
      "version": "latest",
      "packageName": "k6",
      "source": "chocolatey",
      "description": "Modern load testing tool"
    },
    "docker-desktop": {
      "version": "~4.12.0",
      "packageName": "docker-desktop",
      "source": "chocolatey",
      "description": "Docker Desktop for Windows (local) / Docker CE (CI)",
      "ciScript": "BuildScript\\install-docker-ce.ps1",
      "useCiScriptInCi": true
    },
    "psake": {
      "version": "~4.9.0",
      "packageName": "psake",
      "source": "powershellgallery",
      "description": "PowerShell-based build automation tool"
    },
    "aws.tools.installer": {
      "version": "~1.0.2",
      "packageName": "AWS.Tools.Installer",
      "source": "powershellgallery",
      "description": "AWS Tools for PowerShell Installer"
    },
    "aws.tools.s3": {
      "version": "~4.1.39",
      "packageName": "AWS.Tools.S3",
      "source": "powershellgallery",
      "description": "AWS S3 Tools for PowerShell",
      "dependsOn": ["aws.tools.installer"]
    },
    "sqlserver": {
      "version": "~21.1.18221",
      "packageName": "SqlServer",
      "source": "powershellgallery",
      "description": "SQL Server PowerShell module"
    }
  },
  "systemRequirements": {
    "minimumWindowsVersion": "10.0.0.0",
    "minimumPowerShellVersion": "5.1",
    "minimumRAM_GB": 8,
    "minimumDiskSpace_GB": 50,
    "requiresAdmin": true
  },
  "installationOrder": [
    "chocolatey",
    "powershellget",
    "docker-desktop",
    "nvm",
    "node",
    "yarn",
    "dotnetcore-sdk",
    "awscli",
    "7zip",
    "netfx-devpack",
    "curl",
    "k6",
    "psake",
    "aws.tools.installer",
    "aws.tools.s3",
    "sqlserver"
  ]
}
