# Jira Git Integration Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# JIRA CONFIGURATION (Required)
# ============================================================================

# Your Jira site URL (without https://)
# Example: yourcompany.atlassian.net
JIRA_SITE=

# Your Jira account email
JIRA_EMAIL=

# Your Jira API token
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# ============================================================================
# GIT HOOK CONFIGURATION (Optional)
# ============================================================================

# Disable all Jira hooks (set to '1' to disable)
JIRA_HOOK_DISABLED=0

# Auto-transition issues to "In Progress" when checking out branch
# Set to 'true' to enable
JIRA_AUTO_TRANSITION_ON_BRANCH=false

# Disable prepare-commit-msg hook
JIRA_PREPARE_COMMIT_DISABLED=0

# Add commit message template when no issue key found
JIRA_ADD_COMMIT_TEMPLATE=true

# Disable commit message validation
JIRA_COMMIT_VALIDATION_DISABLED=0

# Require issue key in commit messages (will reject commits without)
JIRA_REQUIRE_ISSUE_KEY=false

# Warn if no issue key in commit message
JIRA_WARN_NO_ISSUE_KEY=true

# Validate conventional commit format (feat:, fix:, etc.)
JIRA_VALIDATE_COMMIT_FORMAT=false

# ============================================================================
# WEBHOOK SERVER CONFIGURATION (Optional)
# ============================================================================

# Host for webhook server
WEBHOOK_HOST=0.0.0.0

# Port for webhook server
WEBHOOK_PORT=5000

# Enable debug mode
WEBHOOK_DEBUG=false

# Bitbucket webhook secret for signature verification
BITBUCKET_WEBHOOK_SECRET=

# Auto-transition issues when PR is created
JIRA_AUTO_TRANSITION_PR=true

# ============================================================================
# ADVANCED CONFIGURATION (Optional)
# ============================================================================

# Custom transition mappings (comma-separated)
# Format: keyword:Jira Status Name
# JIRA_CUSTOM_TRANSITIONS=review:Code Review,qa:QA Testing

# Default project for operations
JIRA_DEFAULT_PROJECT=

# ============================================================================
# NOTES
# ============================================================================
#
# Smart Commit Syntax:
#   #time <duration>     - Log work (e.g., 2h 30m, 1d 4h)
#   #comment <text>      - Add comment to issue
#   #<transition>        - Transition issue (e.g., #in-progress, #done)
#
# Supported Transitions (customize in Jira):
#   #in-progress, #progress, #start
#   #in-review, #review, #code-review
#   #done, #complete, #resolved
#   #qa-ready, #qa, #testing
#   #deployed, #deploy
#   #blocked
#
# Branch Naming Convention:
#   ISSUE-KEY-description (e.g., PHARM-456-add-filtering)
#
# Commit Message Format:
#   [ISSUE-KEY] type: description
#
#   Example:
#   [PHARM-456] feat: add package type filtering
#
# Multiple Smart Commands:
#   [PHARM-456] feat: add filtering #time 2h #comment Ready for review #in-review
#
